{
	"name": "@standalone/accounts",
	"version": "0.4.0",
	"private": true,
	"description": "Server half of the Standalone account framework; AccountKit (Swift) lives in the same repo.",
	"type": "module",
	"exports": {
		".": "./server/dist/index.js"
	},
	"types": "./server/dist/index.d.ts",
	"files": [
		"server/dist",
		"server/migrations",
		"server/certs",
		"contract"
	],
	"scripts": {
		"build": "tsc -p server/tsconfig.build.json",
		"prepare": "npm run build",
		"test": "vitest run --root server",
		"typecheck": "tsc -p server/tsconfig.json --noEmit",
		"contract:openapi": "tsx server/scripts/openapi.ts",
		"format": "prettier --write server"
	},
	"peerDependencies": {
		"@apple/app-store-server-library": "^3.1.0",
		"fastify": "^5.12.0",
		"kysely": "^0.29.0",
		"zod": "^4.1.0"
	},
	"devDependencies": {
		"@apple/app-store-server-library": "^3.1.0",
		"@types/node": "^26.6.2",
		"@types/pg": "^8.23.1",
		"fastify": "^5.12.5",
		"kysely": "^0.29.6",
		"pg": "^8.23.0",
		"prettier": "^3.9.8",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.0.1",
		"zod": "^4.6.5"
	},
	"dependencies": {
		"bcryptjs": "^3.0.3",
		"jose": "^6.2.12"
	}
}
